# Copy this file to ".env" and fill in your own values.
# Supabase Dashboard > Project Settings > API (or "Data API" / "API Keys")
#
# Use ONLY the public anon / publishable key here. It is safe in the browser
# because Row Level Security (security.sql) decides what each user may do.
# NEVER put the service_role / secret key in this file or in any front-end code.
#
# ".env" is listed in .gitignore, so your real values are not committed.
# When deploying (Netlify, Vercel, ...), set these two as environment
# variables in the hosting dashboard instead.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
